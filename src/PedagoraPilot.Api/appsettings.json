{
  "Application": {
    "ProductName": "Pedagora Pilot",
    "TechnicalName": "PedagoraPilot.Api",
    "ApplicationCode": "pedagora-pilot"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=PedagoraPilot;Username=postgres;Password=locaguest",
    "Audit": "Host=localhost;Port=5432;Database=PedagoraPilot;Username=postgres;Password=locaguest"
  },
  "Database": {
    "Provider": "PostgreSql",
    "CommandTimeoutSeconds": 30
  },
  "AuthGate": {
    "BaseUrl": "https://localhost:8081",
    "Issuer": "AuthGate",
    "Audience": "PedagoraPilot",
    "ClientId": "pedagora-pilot-web",
    "ApplicationCode": "pedagora-pilot",
    "JwksPath": "/.well-known/jwks.json",
    "ProvisioningScope": "pedagora-pilot.provisioning",
    "AllowHttpForDevelopment": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "DomainRelay": {
    "Outbox": {
      "BatchSize": 100,
      "PollingIntervalSeconds": 2,
      "LeaseDurationSeconds": 30,
      "MaxAttempts": 12,
      "ProcessedRetentionDays": 14
    }
  },
  "Idempotency": {
    "Enabled": true,
    "RequireForUnsafeMethods": true,
    "RetentionHours": 24,
    "MaxResponseBytes": 1048576
  },
  "Realtime": {
    "Enabled": true,
    "HubPath": "/hubs/notifications"
  },
  "Brevo": {
    "Mode": "BREVO_API",
    "ApiKey": "CHANGE_ME",
    "ApiBaseUrl": "https://api.brevo.com",
    "SenderName": "Pedagora Pilot",
    "SenderEmail": "noreply@example.com",
    "Sandbox": true,
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "SmtpUseTls": true,
    "ContextTagsCsv": "pedagora-pilot-dev,svc-pedagora-pilot-api",
    "WebhookToken": "CHANGE_ME",
    "EnableSending": false,
    "MaxRetries": 7
  },
  "EmailDispatcher": {
    "PollSeconds": 5,
    "BatchSize": 10,
    "LockMinutes": 2
  },
  "Demo": {
    "Enabled": true,
    "SeedVersion": "1.0.0"
  },
  "Seq": {
    "ServerUrl": "https://localhost:8081"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq",
      "Serilog.Expressions",
      "Serilog.Sinks.PostgreSQL",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.ClientInfo",
      "Serilog.Enrichers.CorrelationId",
      "Serilog.Sinks.PostgreSQL.Configuration"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithClientIp",
      "WithCorrelationId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "PedagoraPilot"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Microsoft.EntityFrameworkCore')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "%PEDAGORA_PILOT_HOME%/log/PedagoraPilot/PedagoraPilotService_log.txt",
                  "fileSizeLimitBytes": 104857600,
                  "rollOnFileSizeLimit": true,
                  "retainedFileCountLimit": 100,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Microsoft.EntityFrameworkCore')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "%PEDAGORA_PILOT_HOME%/log/PedagoraPilot/EntityFramework/EntityFramework_log.txt",
                  "fileSizeLimitBytes": 104857600,
                  "rollOnFileSizeLimit": true,
                  "retainedFileCountLimit": 100,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties}{NewLine}{Exception}",
                  "restrictedToMinimumLevel": "Information"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "https://localhost:8081"
        }
      },
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Host=localhost;Port=5432;Database=PedagoraPilot;Username=postgres;Password=CHANGE_ME",
          "tableName": "AppLogs",
          "needAutoCreateTable": true,
          "schemaName": "observability",
          "useCopy": false,
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "FileSystem",
    "RootPath": "%PEDAGORA_PILOT_HOME%/storage",
    "MaxFileSizeBytes": 26214400,
    "AllowedContentTypes": [
      "application/pdf",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/msword",
      "image/jpeg",
      "image/png"
    ],
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".doc",
      ".jpg",
      ".jpeg",
      ".png"
    ],
    "SecurityScanner": {
      "Provider": "NoOp",
      "ProductionRequired": true
    }
  },
  "DistanceLearning": {
    "DefaultPlatform": "Teams",
    "DefaultSessionTimeZone": "Europe/Paris",
    "AttendanceLateAfterMinutes": 10,
    "DisconnectedAfterMinutes": 15
  },
  "Workforce": {
    "RemoteWork": {
      "Enabled": true,
      "ApprovalRequired": true,
      "MaxDaysPerWeek": 2,
      "HalfDayAllowed": true,
      "EndOfDayReport": true
    }
  },
  "Reporting": {
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "ExportMaxRows": 10000,
    "AuditRetentionDays": 3650
  },
  "ProductionReadiness": {
    "FailFast": true,
    "RequireHttpsAuthGate": true,
    "RequireSecurityScanner": true,
    "ForbidDemoMode": true,
    "ForbidFileSystemStorage": true,
    "RequireEmailSending": true,
    "RequireExplicitCorsOrigins": true
  },
  "Emailing": {
    "ApplyMigrationsOnStartup": false
  }
}
