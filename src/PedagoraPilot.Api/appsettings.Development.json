{
  "Brevo": {
    "EnableSending": false,
    "Sandbox": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "Storage": {
    "Provider": "FileSystem",
    "RootPath": "%PEDAGORA_PILOT_HOME%/storage",
    "MaxFileSizeBytes": 26214400,
    "AllowedContentTypes": [
      "application/pdf",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/msword",
      "image/jpeg",
      "image/png"
    ],
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".doc",
      ".jpg",
      ".jpeg",
      ".png"
    ],
    "SecurityScanner": {
      "Provider": "NoOp",
      "ProductionRequired": true
    }
  },
  "DistanceLearning": {
    "DefaultPlatform": "Teams",
    "DefaultSessionTimeZone": "Europe/Paris",
    "AttendanceLateAfterMinutes": 10,
    "DisconnectedAfterMinutes": 15
  },
  "Workforce": {
    "RemoteWork": {
      "Enabled": true,
      "ApprovalRequired": true,
      "MaxDaysPerWeek": 2,
      "HalfDayAllowed": true,
      "EndOfDayReport": true
    }
  },
  "Reporting": {
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "ExportMaxRows": 10000,
    "AuditRetentionDays": 3650
  },
  "ProductionReadiness": {
    "FailFast": true,
    "RequireHttpsAuthGate": true,
    "RequireSecurityScanner": true,
    "ForbidDemoMode": true,
    "ForbidFileSystemStorage": true,
    "RequireEmailSending": true,
    "RequireExplicitCorsOrigins": true
  },
  "Emailing": {
    "ApplyMigrationsOnStartup": true
  }
}
